<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg">

    <!-- Top bar: App Branding, Weekday, Refresh & Quick Add Action -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_app_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🇪🇹 EthioCal Pro"
            android:textColor="#FBBF24"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_weekday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ቅዳሜ"
            android:textColor="#E2E8F0"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingStart="0dp"
            android:paddingEnd="8dp" />

        <ImageView
            android:id="@+id/widget_btn_refresh"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:padding="4dp"
            android:src="@drawable/ic_widget_refresh"
            android:background="@drawable/widget_chip_bg"
            android:contentDescription="Refresh Widget" />

        <TextView
            android:id="@+id/widget_btn_add_event"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="+ አዲስ"
            android:textColor="#10B981"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:background="@drawable/widget_chip_bg" />
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#243447"
        android:contentDescription="@null" />

    <!-- Center Section: Dual Calendar Display (Ethiopian Primary + Gregorian Companion Card) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Ethiopian Day numbers: Standard & Geez -->
        <LinearLayout
            android:id="@+id/widget_day_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="0dp"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/widget_eth_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5"
                android:textColor="#FDE047"
                android:textSize="32sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/widget_geez_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="፭"
                android:textColor="#F59E0B"
                android:textSize="13sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- Ethiopian Month/Year + Clock -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="0dp"
            android:paddingEnd="6dp">

            <TextView
                android:id="@+id/widget_eth_month_year"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ኅዳር 2019 ዓ.ም"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Ethiopian 12-Hour Clock (Clickable to open clock in app) -->
            <LinearLayout
                android:id="@+id/widget_clock_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="3dp">

                <TextView
                    android:id="@+id/widget_eth_clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏰ 10:07 ሌሊት"
                    android:textColor="#FBBF24"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <!-- Gregorian Date Companion Pill -->
        <LinearLayout
            android:id="@+id/widget_greg_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:background="@drawable/widget_greg_badge_bg">

            <TextView
                android:id="@+id/widget_greg_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌍 G.C."
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_greg_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nov 14"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_greg_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sat, 2026"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#243447"
        android:contentDescription="@null" />

    <!-- Bottom Row: Fasting Status & Upcoming Holiday/Saint -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_fasting_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌿 ጾም"
            android:textColor="#34D399"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/widget_fasting_bg"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/widget_holiday"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="✨ ጽላት: አቡነ ገብረ መንፈስ ቅዱስ"
            android:textColor="#CBD5E1"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
