  "notes": "Traditional EOTC monthly commemorations recurring every Ethiopian month on the given day number. Annual major feasts remain in fixed_holidays / movable_feasts.",
  "commemorations": [
    {"day": 1, "am": "ልደታ ለማርያም እና ኤልያስ", "en": "Lideta & Elias"},
    {"day": 2, "am": "ታዴዎስ ሐዋርያ", "en": "Thaddaeus the Apostle"},
    {"day": 3, "am": "በዓታ ለማርያም", "en": "Ba'eta leMaryam"},
    {"day": 4, "am": "ዮሐንስ ወልደ ነጎድጓድ", "en": "St. John the Evangelist"},
    {"day": 5, "am": "አቡነ ገብረ መንፈስ ቅዱስ (አቦ)", "en": "Abune Gebre Menfes Kidus (Abo)"},
    {"day": 6, "am": "ቁስቋም ማርያም እና ኢየሱስ", "en": "Qusqwam Maryam"},
    {"day": 7, "am": "ቅድስት ሥላሴ", "en": "Holy Trinity (Selassie)"},
    {"day": 8, "am": "አባ ኪሮስ እና ዮሐንስ አፈወርቅ", "en": "Abba Kiros & John Chrysostom"},
    {"day": 9, "am": "ሠለስቱ ምዕት (318ቱ አባቶች)", "en": "318 Church Fathers of Nicaea"},
    {"day": 10, "am": "መስቀለ ክርስቶስ", "en": "Feast of the Holy Cross"},
    {"day": 11, "am": "ሐና እና ኢያቄም", "en": "St. Anne & St. Joachim"},
    {"day": 12, "am": "ቅዱስ ሚካኤል ሊቀ መላእክት", "en": "Archangel Michael"},
    {"day": 13, "am": "እግዚአብሔር አብ እና ሩፋኤል", "en": "God the Father & Raphael"},
    {"day": 14, "am": "አባ አረጋዊ እና ገብረ ክርስቶስ", "en": "Abba Aregawi & Gebre Kristos"},
    {"day": 15, "am": "ቅዱስ ቂርቆስ እና ኢየሉጣ", "en": "St. Cyricus & Julitta"},
    {"day": 16, "am": "ኪዳነ ምሕረት", "en": "Kidane Mihret (Covenant of Mercy)"},
    {"day": 17, "am": "ቅዱስ እስጢፋኖስ ቀዳሜ ሰማዕት", "en": "St. Stephen Protomartyr"},
    {"day": 18, "am": "አቡነ ኤዎስጣቴዎስ", "en": "Abune Ewostatewos"},
    {"day": 19, "am": "ቅዱስ ገብርኤል ሊቀ መላእክት", "en": "Archangel Gabriel"},
    {"day": 20, "am": "ሕንፀተ ቤተክርስቲያን", "en": "Dedication of St. Mary Church"},
    {"day": 21, "am": "እመቤታችን ቅድስት ድንግል ማርያም", "en": "Virgin Mary (Mariam)"},
    {"day": 22, "am": "ቅዱስ ዑራኤል እና ደቅስዮስ", "en": "Archangel Uriel & Daqsios"},
    {"day": 23, "am": "ቅዱስ ጊዮርጊስ ሰማዕት", "en": "St. George the Martyr"},
    {"day": 24, "am": "አቡነ ተክለ ሃይማኖት", "en": "Abune Tekle Haymanot"},
    {"day": 25, "am": "ቅዱስ መርቆሬዎስ ሰማዕት", "en": "St. Mercurius (Abu Seifein)"},
    {"day": 26, "am": "ቅዱስ ቶማስ ሐዋርያ", "en": "St. Thomas the Apostle"},
    {"day": 27, "am": "መድኃኔ ዓለም", "en": "Medhane Alem (Savior of the World)"},
    {"day": 28, "am": "አማኑኤል", "en": "Emmanuel"},
    {"day": 29, "am": "በዓለ ወልድ / ልደት", "en": "Balewold (Feast of God the Son)"},
    {"day": 30, "am": "ቅዱስ ማርቆስ ወንጌላዊ", "en": "St. Mark the Evangelist"}
  ]
