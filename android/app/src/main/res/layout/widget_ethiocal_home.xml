<?xml version="1.0" encoding="utf-8"?>
<!-- Executive Zemen Luxury Home Screen Widget Layout (2x2 Canonical) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg_noir">

    <!-- Top Header Bar: Brand Mark on left, Evangelist + Ge'ez Numeral + Refresh Button on right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_home_brand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="ዘመን · ZEMEN"
            android:textColor="#D4AF74"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/widget_home_evangelist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip_bg"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_marginRight="5dp"
            android:maxLines="1"
            android:text="ዘመነ ማቴዎስ"
            android:textColor="#EAD3AB"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_home_geez"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip_bg"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_marginRight="6dp"
            android:maxLines="1"
            android:text="፲፫"
            android:textColor="#F0DFB8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/widget_home_refresh"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:padding="3dp"
            android:src="@drawable/ic_widget_refresh"
            android:contentDescription="Refresh Widget" />
    </LinearLayout>

    <!-- Center Hero Card: Big Gold Ethiopian Day Numeral + Vertical Divider + Month / Year / Weekday -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp">

        <!-- Left Column: Giant Day Numeral -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/widget_home_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="13"
                android:textColor="#D4AF74"
                android:textSize="48sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Vertical Subtle Gold Accent Divider -->
        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="11dp"
            android:layout_marginRight="11dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:background="#2FD4AF74" />

        <!-- Right Column: Month Name, Year, Weekday -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_home_month"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="ኅዳር"
                android:textColor="#FAF6EF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_home_year"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="2019 ዓ.ም"
                android:textColor="#C8A96B"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_home_weekday"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="እሑድ · Sunday"
                android:textColor="#9AA3B2"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Glowing Gold Accent Divider -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@drawable/widget_accent_bar"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="5dp" />

    <!-- Bottom Footer: Gregorian Dual Date on Left, Saint / Holiday Chip on Right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_home_greg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="November 22, 2026"
            android:textColor="#9AA3B2"
            android:textSize="10.5sp" />

        <TextView
            android:id="@+id/widget_home_headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_holiday_chip"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="ቅዱስ ጊዮርጊስ"
            android:textColor="#F0DFB8"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
